KX_HOST=172.16.0.3
KX_SNMP_COMMUNITY=public
PORT=3000
# Needed to embed the console: the backend logs in to the KX with these (never sent to the browser).
KX_USER=
KX_PASSWORD=
# The id in HKC's portId (P_<id>_<n>); read from the Client.asp URL you captured.
KX_DEVICE_ID=000d5d11da6a
# SSH key login for the sessions panel (user defaults to KX_USER).
# KX_SSH_KEY=~/.ssh/kx3_rsa
# Accounts are created in the browser at first launch (see README). To serve other machines set BIND=0.0.0.0 and
# ALLOWED_HOSTS to the name you browse to, and put HTTPS in front.
# BIND=127.0.0.1
# ALLOWED_HOSTS=
# Docker only: a code of your choice that lets you create the first administrator from the browser (remove it afterwards).
# KX_SETUP_TOKEN=
